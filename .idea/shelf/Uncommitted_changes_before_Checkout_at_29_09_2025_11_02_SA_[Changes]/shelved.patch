+package com.swp.evmsystem.exception;
+
+public class GlobalExceptionHandler {
+    @ExceptionHandler(LoginResponseException.class)
+    public ResponseEntity<Object> handleLoginException(LoginResponseException ex) {
+        Map<String, Object> body = new HashMap<>();
+        body.put("timestamp", LocalDateTime.now().toString());
+        // Thời điểm xảy ra lỗi
+
+        body.put("status", HttpStatus.UNAUTHORIZED.value());
+        // Mã lỗi HTTP 401 (chưa xác thực)
+
+        body.put("error", "Unauthorized");
+        // Tên lỗi: Unauthorized
+
+        body.put("message", ex.getMessage());
+        // Lấy message từ exception (ví dụ: "Sai mật khẩu")
+
+        return new ResponseEntity<>(body, HttpStatus.UNAUTHORIZED);
+        // Trả JSON + status 401
+        }
+
+    @ExceptionHandler(Exception.class)
+    // Bắt mọi Exception không được handle riêng
+    public ResponseEntity<Object> handleGeneralException(Exception ex) {
+        Map<String, Object> body = new HashMap<>();
+        // JSON body chứa thông tin lỗi
+
+        body.put("timestamp", LocalDateTime.now().toString());
+        // Thời điểm xảy ra lỗi
+
+        body.put("status", HttpStatus.INTERNAL_SERVER_ERROR.value());
+        // Mã lỗi HTTP 500 (lỗi server)
+
+        body.put("error", "Internal Server Error");
+        // Tên lỗi: Internal Server Error
+
+        body.put("message", ex.getMessage());
+        // Thông điệp lỗi chi tiết
+
+        return new ResponseEntity<>(body, HttpStatus.INTERNAL_SERVER_ERROR);
+        // Trả JSON + status 500
+    }
+    }
